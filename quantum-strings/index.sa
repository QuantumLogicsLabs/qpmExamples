# quantum-strings — everyday string helpers for Quantum
#
#   Strings.camelCase("hello world")          # "helloWorld"
#   Strings.slugify("Hello, World!")          # "hello-world"
#   Strings.template("Hi {{name}}", {"name": "Ada"})
#
# Exposes the global: Strings

class __QStrings {
    # ── words & case ─────────────────────────────────────────────────────

    # Splits text into words on spaces/punctuation and camelCase boundaries.
    #   words("parseHTTPResponse_code") -> ["parse", "HTTP", "Response", "code"]
    fn words(s) {
        let out = []
        let cur = ""
        let n = len(s)
        for i in range(n) {
            let ch = s[i]
            if not ch.isalnum() {
                if cur != "" { out.push(cur) }
                cur = ""
                continue
            }
            if cur != "" {
                let prev = s[i - 1]
                let next = i + 1 < n ? s[i + 1] : ""
                let lowerToUpper = prev.islower() and ch.isupper()
                let acronymEnd = prev.isupper() and ch.isupper() and next != "" and next.islower()
                let letterDigit = prev.isalpha() != ch.isalpha()
                if lowerToUpper or acronymEnd or letterDigit {
                    out.push(cur)
                    cur = ""
                }
            }
            cur += ch
        }
        if cur != "" { out.push(cur) }
        return out
    }

    fn capitalize(s) {
        if s == "" { return s }
        return s[0].upper() + s.slice(1)
    }

    fn camelCase(s) {
        let w = self.words(s)
        let out = ""
        for i in range(len(w)) {
            out += i == 0 ? w[i].lower() : self.capitalize(w[i].lower())
        }
        return out
    }

    fn pascalCase(s) {
        let out = ""
        for w in self.words(s) { out += self.capitalize(w.lower()) }
        return out
    }

    fn snakeCase(s) {
        return self.words(s).map(fn(w) { return w.lower() }).join("_")
    }

    fn kebabCase(s) {
        return self.words(s).map(fn(w) { return w.lower() }).join("-")
    }

    fn constantCase(s) {
        return self.words(s).map(fn(w) { return w.upper() }).join("_")
    }

    fn titleCase(s) {
        return self.words(s).map(fn(w) { return Strings.capitalize(w.lower()) }).join(" ")
    }

    # URL-friendly slug: "Hello, World!" -> "hello-world"
    fn slugify(s) {
        return self.kebabCase(s.replaceAll("'", ""))
    }

    fn initials(name) {
        let out = ""
        for w in name.trim().split(" ") {
            if w != "" { out += w[0].upper() }
        }
        return out
    }

    # ── shaping ──────────────────────────────────────────────────────────

    fn truncate(s, maxLen, suffix) {
        if suffix == null { suffix = "..." }
        if len(s) <= maxLen { return s }
        let keep = maxLen - len(suffix)
        if keep < 0 { keep = 0 }
        return s.slice(0, keep).trim() + suffix
    }

    fn padLeft(s, width, ch) {
        if ch == null { ch = " " }
        s = str(s)
        while len(s) < width { s = ch + s }
        return s
    }

    fn padRight(s, width, ch) {
        if ch == null { ch = " " }
        s = str(s)
        while len(s) < width { s += ch }
        return s
    }

    fn center(s, width, ch) {
        if ch == null { ch = " " }
        s = str(s)
        let total = width - len(s)
        if total <= 0 { return s }
        let left = floor(total / 2)
        return ch.repeat(left) + s + ch.repeat(total - left)
    }

    # Word-wraps text to lines of at most `width` characters.
    fn wrap(text, width) {
        let lines = []
        let line = ""
        for w in text.replaceAll("\n", " ").split(" ") {
            if w == "" { continue }
            if line == "" {
                line = w
            } else if len(line) + 1 + len(w) <= width {
                line += " " + w
            } else {
                lines.push(line)
                line = w
            }
        }
        if line != "" { lines.push(line) }
        return lines.join("\n")
    }

    fn indent(text, spaces) {
        let pad = " ".repeat(spaces)
        return text.split("\n").map(fn(l) { return l == "" ? l : pad + l }).join("\n")
    }

    fn reverse(s) {
        let out = ""
        for i in range(len(s) - 1, -1, -1) { out += s[i] }
        return out
    }

    # Hides all but the last `visible` characters: mask("4111111111111111") -> "************1111"
    fn mask(s, visible, ch) {
        if visible == null { visible = 4 }
        if ch == null { ch = "*" }
        if len(s) <= visible { return s }
        return ch.repeat(len(s) - visible) + s.slice(len(s) - visible)
    }

    # ── inspection ───────────────────────────────────────────────────────

    fn isBlank(s) {
        return s == null or s.trim() == ""
    }

    fn isPalindrome(s) {
        let clean = ""
        for ch in s.lower().chars() {
            if ch.isalnum() { clean += ch }
        }
        return clean == self.reverse(clean)
    }

    fn count(s, sub) {
        if sub == "" { return 0 }
        let n = 0
        let i = s.indexOf(sub)
        while i != -1 {
            n += 1
            let rest = s.slice(i + len(sub))
            let j = rest.indexOf(sub)
            i = j == -1 ? -1 : i + len(sub) + j
        }
        return n
    }

    # Text between the first `start` marker and the following `end` marker, or null.
    fn between(s, start, end) {
        let i = s.indexOf(start)
        if i == -1 { return null }
        let rest = s.slice(i + len(start))
        let j = rest.indexOf(end)
        if j == -1 { return null }
        return rest.slice(0, j)
    }

    # -1, 0 or 1 in lexicographic order (Quantum's `<` does not compare strings).
    fn compare(a, b) {
        let c = strcmp(a, b)
        if c < 0 { return -1 }
        if c > 0 { return 1 }
        return 0
    }

    # 0.0 (nothing alike) .. 1.0 (identical), based on edit distance.
    fn similarity(a, b) {
        let longest = max(len(a), len(b))
        if longest == 0 { return 1 }
        return 1 - edit_distance(a, b) / longest
    }

    # Picks the candidate closest to `input` (e.g. "did you mean ...?").
    fn closest(input, candidates) {
        let best = null
        let bestScore = -1
        for c in candidates {
            let score = self.similarity(input.lower(), c.lower())
            if score > bestScore {
                best = c
                bestScore = score
            }
        }
        return best
    }

    # ── formatting ───────────────────────────────────────────────────────

    # Replaces {{key}} (and {{ key }}) placeholders; unknown keys are left as-is.
    fn template(tpl, data) {
        let out = tpl
        for k in data.keys() {
            let v = str(data[k])
            out = out.replaceAll("{{" + k + "}}", v).replaceAll("{{ " + k + " }}", v)
        }
        return out
    }

    fn escapeHtml(s) {
        return s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("\"", "&quot;").replaceAll("'", "&#39;")
    }

    fn unescapeHtml(s) {
        return s.replaceAll("&lt;", "<").replaceAll("&gt;", ">").replaceAll("&quot;", "\"").replaceAll("&#39;", "'").replaceAll("&amp;", "&")
    }

    # pluralize(1, "file") -> "1 file", pluralize(3, "box", "boxes") -> "3 boxes"
    fn pluralize(n, singular, plural) {
        if plural == null { plural = singular + "s" }
        return str(n) + " " + (n == 1 ? singular : plural)
    }

    # 1 -> "1st", 12 -> "12th", 23 -> "23rd"
    fn ordinal(n) {
        let mod100 = n % 100
        if mod100 >= 11 and mod100 <= 13 { return str(n) + "th" }
        let last = n % 10
        if last == 1 { return str(n) + "st" }
        if last == 2 { return str(n) + "nd" }
        if last == 3 { return str(n) + "rd" }
        return str(n) + "th"
    }

    # 1234567.891 -> "1,234,567.89"
    fn formatNumber(n, decimals, sep) {
        if decimals == null { decimals = 0 }
        if sep == null { sep = "," }
        let negative = n < 0
        let fixed = sprintf("%." + str(decimals) + "f", abs(n))
        let dot = fixed.indexOf(".")
        let whole = dot == -1 ? fixed : fixed.slice(0, dot)
        let frac = dot == -1 ? "" : fixed.slice(dot)
        let grouped = ""
        let count = 0
        for i in range(len(whole) - 1, -1, -1) {
            if count > 0 and count % 3 == 0 { grouped = sep + grouped }
            grouped = whole[i] + grouped
            count += 1
        }
        return (negative ? "-" : "") + grouped + frac
    }

    # 1536 -> "1.5 KB"
    fn formatBytes(bytes) {
        let units = ["B", "KB", "MB", "GB", "TB"]
        let size = bytes
        let u = 0
        while size >= 1024 and u < len(units) - 1 {
            size = size / 1024
            u += 1
        }
        if u == 0 { return str(bytes) + " B" }
        return sprintf("%.1f", size) + " " + units[u]
    }
}

Strings = __QStrings()
