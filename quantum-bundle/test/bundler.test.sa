# @use quantum-test
# @use ../lib/bundler.sa

describe("Bundler paths", fn() {
    it("normalizes separators and dot segments", fn() {
        expect(Bundler.normalize("a\\b\\..\\c/./d.sa")).toBe("a/c/d.sa")
        expect(Bundler.normalize("./x.sa")).toBe("x.sa")
        expect(Bundler.normalize("../../x")).toBe("../../x")
        expect(Bundler.normalize("C:\\proj\\src\\..\\lib")).toBe("C:/proj/lib")
        expect(Bundler.normalize("/usr/../etc")).toBe("/etc")
        expect(Bundler.normalize("")).toBe(".")
    })

    it("joins relative and absolute paths", fn() {
        expect(Bundler.join("src", "../lib/a.sa")).toBe("lib/a.sa")
        expect(Bundler.join(".", "node_modules")).toBe("node_modules")
        expect(Bundler.join("src", "C:/abs/x.sa")).toBe("C:/abs/x.sa")
    })

    it("computes dirname", fn() {
        expect(Bundler.dirname("src/app/main.sa")).toBe("src/app")
        expect(Bundler.dirname("main.sa")).toBe(".")
        expect(Bundler.dirname("/main.sa")).toBe("/")
    })
})

describe("Bundler directives", fn() {
    it("parses @use lines in order, ignoring other comments", fn() {
        src = "# header\n# @use quantum-strings\n  # @use \"./helpers.sa\"\nx = 1 # @use nope\n#@use nospace\n"
        expect(Bundler.parseUses(src)).toEqual(["quantum-strings", "./helpers.sa"])
    })

    it("parses package specs", fn() {
        expect(Bundler.parsePackageSpec("quantum-math")).toEqual({"name": "quantum-math", "sub": ""})
        expect(Bundler.parsePackageSpec("quantum-math/stats.sa")).toEqual({"name": "quantum-math", "sub": "stats.sa"})
        expect(Bundler.parsePackageSpec("@acme/tools/x.sa")).toEqual({"name": "@acme/tools", "sub": "x.sa"})
    })
})

describe("Bundler resolution", fn() {
    it("finds sibling packages through extra paths", fn() {
        path = Bundler.resolve("quantum-test", "test", {"root": ".", "paths": [".."]})
        expect(path).toBe("../quantum-test/index.sa")
    })

    it("uses package.json main", fn() {
        path = Bundler.resolve("quantum-bundle", ".", {"root": ".", "paths": [".."]})
        expect(path).toBe("../quantum-bundle/lib/bundler.sa")
    })

    it("reports every location it tried", fn() {
        message = ""
        try {
            Bundler.resolve("no-such-package", ".", {"root": ".", "paths": [".."]})
        } catch (e) {
            message = str(e)
        }
        expect(message).toContain("no-such-package")
        expect(message).toContain("node_modules/no-such-package/index.sa")
    })

    it("raises for missing relative files", fn() {
        expect(fn() { Bundler.resolve("./missing.sa", "src", {}) }).toThrow()
    })
})

describe("Bundler build", fn() {
    # Fixtures: main uses a and b; b also uses a; a uses main (a cycle).
    write_file("build/fx_a.sa", "# @use ./fx_main.sa\nfx_log = [\"a\"]\n")
    write_file("build/fx_b.sa", "# @use ./fx_a.sa\nfx_log.push(\"b\")\n")
    write_file("build/fx_main.sa", "# @use ./fx_a.sa\n# @use ./fx_b.sa\nfx_log.push(\"main\")\n")

    it("orders dependencies first and includes each file once", fn() {
        result = Bundler.bundleSource("build/fx_main.sa", {"root": "."})
        paths = result["modules"].map(fn(m) { return m["path"] })
        expect(paths).toEqual(["build/fx_a.sa", "build/fx_b.sa", "build/fx_main.sa"])
    })

    it("warns about circular uses instead of looping", fn() {
        result = Bundler.bundleSource("build/fx_main.sa", {"root": "."})
        expect(len(result["warnings"])).toBe(1)
        expect(result["warnings"][0]).toContain("fx_main.sa")
    })

    it("writes a bundle file", fn() {
        info = Bundler.build("build/fx_main.sa", "build/fx_out.sa", {"root": "."})
        expect(info["modules"]).toBe(3)
        text = read_file("build/fx_out.sa")
        expect(text).toContain("# Generated by quantum-bundle")
        expect(text.indexOf("fx_log = ")).toBeLessThan(text.indexOf("fx_log.push(\"main\")"))
    })

    it("strips a UTF-8 BOM", fn() {
        write_file("build/fx_bom.sa", chr(239) + chr(187) + chr(191) + "x = 1\n")
        expect(Bundler.readText("build/fx_bom.sa")).toBe("x = 1\n")
    })

    it("raises when the output directory is missing", fn() {
        expect(fn() { Bundler.build("build/fx_main.sa", "no_dir_here/out.sa", {"root": "."}) }).toThrow()
    })
})

Test.report()
