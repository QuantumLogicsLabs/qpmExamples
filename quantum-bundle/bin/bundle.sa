# quantum-bundle — library
#
# Quantum has no runtime module loader yet (`import` parses but does nothing),
# so this bundler resolves dependencies ahead of time: it follows
# `# @use <spec>` comment directives and inlines every dependency, in
# dependency order, into one standalone .sa file that `qrun` can execute.
#
#   # @use quantum-strings          -> node_modules/quantum-strings/<main>
#   # @use quantum-strings/extra.sa -> a file inside that package
#   # @use ./helpers.sa             -> relative to the current file
#
# Because the directives are comments, un-bundled files still parse.
# Exposes the global: Bundler

class __QBundler {
    fn init() {
        self.USE_PREFIX = "# @use "
    }

    # ── paths ────────────────────────────────────────────────────────────

    fn isAbsolute(p) {
        p = p.replaceAll("\\", "/")
        if p.startsWith("/") { return true }
        return len(p) >= 2 and p[1] == ":"
    }

    # Collapses "." and ".." segments and unifies separators to "/".
    fn normalize(p) {
        p = p.replaceAll("\\", "/")
        let lead = ""
        if len(p) >= 2 and p[1] == ":" {
            lead = p.slice(0, 2)
            p = p.slice(2)
        }
        let rooted = p.startsWith("/")
        let out = []
        for seg in p.split("/") {
            if seg == "" or seg == "." { continue }
            if seg == ".." {
                if len(out) > 0 and out[-1] != ".." {
                    out.pop()
                } else if not rooted {
                    out.push("..")
                }
                continue
            }
            out.push(seg)
        }
        let body = out.join("/")
        if rooted { body = "/" + body }
        let result = lead + body
        if result == "" { return "." }
        return result
    }

    fn join(a, b) {
        if self.isAbsolute(b) { return self.normalize(b) }
        return self.normalize(a + "/" + b)
    }

    fn dirname(p) {
        p = self.normalize(p)
        let idx = -1
        for i in range(len(p)) {
            if p[i] == "/" { idx = i }
        }
        if idx == -1 { return "." }
        if idx == 0 { return "/" }
        return p.slice(0, idx)
    }

    # Files only: os.path.exists opens the path for reading, so it is
    # always false for directories.
    fn exists(p) {
        return os.path.exists(p)
    }

    # ── source files ─────────────────────────────────────────────────────

    # Reads a text file, dropping a UTF-8 BOM (the Quantum lexer rejects it).
    fn readText(p) {
        let text = read_file(p)
        if text == null { return null }
        if len(text) >= 3 and ord(text[0]) == 239 and ord(text[1]) == 187 and ord(text[2]) == 191 {
            text = text.slice(3)
        }
        return text
    }

    # Returns the dependency specs declared by `# @use` lines, in order.
    fn parseUses(source) {
        let specs = []
        for raw in source.split("\n") {
            let line = raw.trim()
            if not line.startsWith(self.USE_PREFIX) { continue }
            let spec = line.slice(len(self.USE_PREFIX)).trim()
            if len(spec) >= 2 and (spec[0] == "\"" or spec[0] == "'") {
                spec = spec.slice(1, len(spec) - 1)
            }
            if spec != "" { specs.push(spec) }
        }
        return specs
    }

    fn isRelativeSpec(spec) {
        return spec.startsWith("./") or spec.startsWith("../") or self.isAbsolute(spec)
    }

    # Splits "name/sub/file.sa" (or "@scope/name/file.sa") into package + subpath.
    # (Not named split...: the .sa front-end rewrites identifiers starting with ".split".)
    fn parsePackageSpec(spec) {
        let parts = spec.split("/")
        let count = 1
        if spec.startsWith("@") and len(parts) > 1 { count = 2 }
        let sub = ""
        if len(parts) > count { sub = parts.slice(count).join("/") }
        return {"name": parts.slice(0, count).join("/"), "sub": sub}
    }

    fn packageMain(pkgDir) {
        let manifest = pkgDir + "/package.json"
        if not self.exists(manifest) { return pkgDir + "/index.sa" }
        let meta = null
        try {
            meta = JSON.parse(self.readText(manifest))
        } catch (e) {
            raise "invalid package.json at " + manifest + ": " + str(e)
        }
        if type(meta) == "dict" and type(meta.get("main")) == "string" {
            return self.join(pkgDir, meta["main"])
        }
        return pkgDir + "/index.sa"
    }

    # Resolves a spec to a file path. `options.root` is the project directory;
    # `options.paths` lists extra package directories (e.g. ".." for siblings).
    fn resolve(spec, fromDir, options) {
        if self.isRelativeSpec(spec) {
            let target = self.join(fromDir, spec)
            if self.exists(target) { return target }
            raise "cannot find '" + spec + "' (looked for " + target + ")"
        }

        let root = options.get("root", ".")
        let pkg = self.parsePackageSpec(spec)
        let searchDirs = [self.join(root, "node_modules")]
        for extra in options.get("paths", []) {
            searchDirs.push(self.join(root, extra))
        }

        let tried = []
        for dir in searchDirs {
            let pkgDir = self.join(dir, pkg["name"])
            let target = pkg["sub"] == "" ? self.packageMain(pkgDir) : self.join(pkgDir, pkg["sub"])
            if self.exists(target) { return target }
            tried.push(target)
        }
        raise "cannot find package '" + spec + "' (tried: " + tried.join(", ") + ")"
    }

    # ── bundling ─────────────────────────────────────────────────────────

    # Depth-first walk: every module appears after all of its dependencies,
    # and each file is included once even if several modules use it.
    fn collect(entry, options) {
        let state = {"order": [], "done": {}, "visiting": {}, "warnings": []}
        let entryPath = self.normalize(entry)
        if not self.exists(entryPath) {
            raise "entry file not found: " + entryPath
        }
        self.visit(entryPath, entry, options, state)
        return state
    }

    fn visit(path, spec, options, state) {
        let key = path.lower()
        if key in state["done"] { return }
        if key in state["visiting"] {
            state["warnings"].push("circular @use skipped: " + path)
            return
        }
        state["visiting"][key] = true

        let source = self.readText(path)
        if source == null { raise "cannot read " + path }

        for dep in self.parseUses(source) {
            self.visit(self.resolve(dep, self.dirname(path), options), dep, options, state)
        }

        state["visiting"].delete(key)
        state["done"][key] = true
        state["order"].push({"path": path, "spec": spec, "source": source})
    }

    # Returns {"text", "modules", "warnings"} without writing anything.
    fn bundleSource(entry, options) {
        if options == null { options = {} }
        let state = self.collect(entry, options)
        let chunks = [
            "# Generated by quantum-bundle. Do not edit; rebuild from " + self.normalize(entry) + "\n"
        ]
        for mod in state["order"] {
            let body = mod["source"]
            if not body.endsWith("\n") { body += "\n" }
            chunks.push("\n# ── module: " + mod["spec"] + " (" + mod["path"] + ") ──\n" + body)
        }
        return {"text": chunks.join(""), "modules": state["order"], "warnings": state["warnings"]}
    }

    # Bundles `entry` into `out`. Returns {"out", "modules", "bytes", "warnings"}.
    fn build(entry, out, options) {
        let result = self.bundleSource(entry, options)
        if not write_file(out, result["text"]) {
            raise "cannot write " + out + " (does its directory exist?)"
        }
        return {
            "out": out,
            "modules": len(result["modules"]),
            "bytes": len(result["text"]),
            "warnings": result["warnings"]
        }
    }
}

Bundler = __QBundler()

# ── module: src/cli.sa (src/cli.sa) ──
# quantum-bundle — command-line entry point
#
# Run from a project directory (qrun does not pass script arguments, so all
# configuration comes from the "quantum" field of ./package.json):
#
#   "quantum": {
#     "paths":   [".."],                          optional extra package dirs
#     "bundles": [
#       { "entry": "src/main.sa", "out": "build/main.sa" }
#     ]
#   }
#
# A single bundle may also be written as "entry"/"out" directly on "quantum".
# bin/bundle.sa is this file pre-bundled with lib/bundler.sa.

# @use ../lib/bundler.sa

# Quantum has no exit(); an uncaught raise is what gives a non-zero exit code.
fn __qbundleFail(message) {
    raise "[quantum-bundle] " + message
}

fn __qbundleMain() {
    let manifestText = Bundler.readText("package.json")
    if manifestText == null {
        __qbundleFail("no package.json in the current directory")
    }

    let manifest = null
    try {
        manifest = JSON.parse(manifestText)
    } catch (e) {
        __qbundleFail("package.json is not valid JSON: " + str(e))
    }

    let config = manifest.get("quantum")
    if type(config) != "dict" {
        __qbundleFail("package.json has no \"quantum\" config, e.g. \"quantum\": { \"entry\": \"src/main.sa\", \"out\": \"build/main.sa\" }")
    }

    let bundles = config.get("bundles", [])
    if config.get("entry") != null {
        bundles = [{"entry": config["entry"], "out": config.get("out")}] + bundles
    }
    if len(bundles) == 0 {
        __qbundleFail("\"quantum\" config lists no bundles")
    }

    let options = {"root": ".", "paths": config.get("paths", [])}
    let failed = false
    for b in bundles {
        let entry = b.get("entry")
        let out = b.get("out")
        if out == null and entry != null {
            out = "build/" + entry.split("/")[-1]
        }
        # (no `let` inside try: the VM misplaces locals declared there after a catch)
        let result = null
        try {
            result = Bundler.build(entry, out, options)
        } catch (e) {
            print("[quantum-bundle] error in " + str(entry) + ": " + str(e))
            failed = true
        }
        if result != null {
            print("[quantum-bundle] " + entry + " -> " + result["out"] + " (" + str(result["modules"]) + " modules, " + str(result["bytes"]) + " bytes)")
            for w in result["warnings"] { print("[quantum-bundle] warning: " + w) }
        }
    }
    if failed { __qbundleFail("build failed") }
}

__qbundleMain()
