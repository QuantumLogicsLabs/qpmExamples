# quantum-csv — read and write CSV for Quantum
#
#   rows = CSV.parse("name,age\nAda,36\n")          # [{"name": "Ada", "age": 36}]
#   text = CSV.stringify(rows)                       # "name,age\nAda,36\n"
#   rows = CSV.readFile("people.csv")
#   CSV.writeFile("out.csv", rows)
#
# Handles quoted fields, "" escapes, delimiters and newlines inside quotes,
# CRLF line endings and a UTF-8 BOM.
# Exposes the global: CSV

class __QCSV {
    # options:
    #   delimiter  "," (any single character, e.g. ";" or "\t")
    #   header     true -> array of dicts keyed by the first row; false -> array of arrays
    #   numbers    true -> "42" / "-3.5" become numbers
    #   trim       true -> trim whitespace around unquoted fields
    #   skipEmpty  true -> ignore blank lines
    fn parse(text, options) {
        let opts = self.withDefaults(options)
        let rows = self.parseRows(text, opts)
        if not opts["header"] { return rows }
        if len(rows) == 0 { return [] }
        let headers = rows[0]
        let out = []
        for r in range(1, len(rows)) {
            let record = {}
            for c in range(len(headers)) {
                record[headers[c]] = c < len(rows[r]) ? rows[r][c] : null
            }
            out.push(record)
        }
        return out
    }

    fn withDefaults(options) {
        let opts = {"delimiter": ",", "header": true, "numbers": true, "trim": true, "skipEmpty": true}
        if options != null {
            for k in options.keys() { opts[k] = options[k] }
        }
        return opts
    }

    # Low-level parser: always returns an array of arrays of cells.
    fn parseRows(text, opts) {
        if opts == null { opts = self.withDefaults({"header": false}) }
        if len(text) >= 3 and ord(text[0]) == 239 and ord(text[1]) == 187 and ord(text[2]) == 191 {
            text = text.slice(3)
        }
        let delim = opts["delimiter"]
        let rows = []
        let row = []
        let field = ""
        let quoted = false
        let wasQuoted = false
        let i = 0
        let n = len(text)
        while i < n {
            let ch = text[i]
            if quoted {
                if ch == "\"" {
                    if i + 1 < n and text[i + 1] == "\"" {
                        field += "\""
                        i += 1
                    } else {
                        quoted = false
                    }
                } else {
                    field += ch
                }
            } else if ch == "\"" and field.trim() == "" {
                quoted = true
                wasQuoted = true
                field = ""
            } else if ch == delim {
                row.push(self.finishField(field, wasQuoted, opts))
                field = ""
                wasQuoted = false
            } else if ch == "\n" or ch == "\r" {
                if ch == "\r" and i + 1 < n and text[i + 1] == "\n" { i += 1 }
                row.push(self.finishField(field, wasQuoted, opts))
                self.pushRow(rows, row, opts)
                row = []
                field = ""
                wasQuoted = false
            } else {
                field += ch
            }
            i += 1
        }
        if quoted { raise "CSV: unterminated quoted field" }
        if field != "" or wasQuoted or len(row) > 0 {
            row.push(self.finishField(field, wasQuoted, opts))
            self.pushRow(rows, row, opts)
        }
        return rows
    }

    fn pushRow(rows, row, opts) {
        let blank = len(row) == 1 and row[0] == ""
        if blank and opts["skipEmpty"] { return }
        rows.push(row)
    }

    fn finishField(field, wasQuoted, opts) {
        if wasQuoted { return field }
        let value = opts["trim"] ? field.trim() : field
        if opts["numbers"] and self.looksNumeric(value) { return num(value) }
        return value
    }

    fn looksNumeric(s) {
        if s == "" or len(s) > 15 { return false }
        let start = (s[0] == "-" or s[0] == "+") ? 1 : 0
        if start == len(s) { return false }
        let dots = 0
        let digits = 0
        for i in range(start, len(s)) {
            if s[i] == "." {
                dots += 1
            } else if s[i].isdigit() {
                digits += 1
            } else {
                return false
            }
        }
        # Keep leading-zero codes like "007" or ZIP "02134" as text.
        if len(s) - start > 1 and s[start] == "0" and s[start + 1] != "." { return false }
        return dots <= 1 and digits > 0
    }

    # rows: array of dicts (headers from `columns` or the union of keys in first-seen
    # order) or array of arrays. options: {"delimiter", "columns", "header": true}
    fn stringify(rows, options) {
        if options == null { options = {} }
        let delim = options.get("delimiter", ",")
        let lines = []
        if len(rows) == 0 { return "" }
        if type(rows[0]) == "dict" {
            let columns = options.get("columns")
            if columns == null { columns = self.columnsOf(rows) }
            if options.get("header", true) {
                lines.push(columns.map(fn(c) { return CSV.escapeField(c, delim) }).join(delim))
            }
            for r in rows {
                lines.push(columns.map(fn(c) { return CSV.escapeField(r.get(c), delim) }).join(delim))
            }
        } else {
            for r in rows {
                lines.push(r.map(fn(v) { return CSV.escapeField(v, delim) }).join(delim))
            }
        }
        return lines.join("\n") + "\n"
    }

    fn columnsOf(records) {
        let seen = {}
        let columns = []
        for r in records {
            for k in r.keys() {
                if not (k in seen) {
                    seen[k] = true
                    columns.push(k)
                }
            }
        }
        return columns
    }

    fn escapeField(value, delim) {
        if value == null { return "" }
        let s = str(value)
        let needsQuotes = s.contains(delim) or s.contains("\"") or s.contains("\n") or s.contains("\r") or s != s.trim()
        if not needsQuotes { return s }
        return "\"" + s.replaceAll("\"", "\"\"") + "\""
    }

    # ── files ────────────────────────────────────────────────────────────

    fn readFile(path, options) {
        let text = read_file(path)
        if text == null { raise "CSV: cannot read " + path }
        return self.parse(text, options)
    }

    fn writeFile(path, rows, options) {
        if not write_file(path, self.stringify(rows, options)) {
            raise "CSV: cannot write " + path
        }
        return true
    }

    # ── helpers for parsed records ───────────────────────────────────────

    fn column(records, name) {
        return records.map(fn(r) { return r.get(name) })
    }

    fn where(records, name, value) {
        return records.filter(fn(r) { return r.get(name) == value })
    }

    # Renames keys: renameColumns(rows, {"First Name": "first"})
    fn renameColumns(records, mapping) {
        return records.map(fn(r) {
            let out = {}
            for k in r.keys() { out[mapping.get(k, k)] = r[k] }
            return out
        })
    }
}

CSV = __QCSV()
