# @use quantum-test
# @use ../index.sa

describe("DateTime calendar", fn() {
    it("knows leap years and month lengths", fn() {
        expect([2000, 2024, 1900, 2023].map(fn(y) { return DateTime.isLeapYear(y) })).toEqual([true, true, false, false])
        expect(DateTime.daysInMonth(2024, 2)).toBe(29)
        expect(DateTime.daysInMonth(2023, 2)).toBe(28)
        expect(DateTime.daysInMonth(2024, 4)).toBe(30)
    })
    it("converts between parts and epoch seconds", fn() {
        expect(DateTime.fromParts(1970, 1, 1)).toBe(0)
        expect(DateTime.fromParts(2000, 1, 1)).toBe(946684800)
        expect(DateTime.fromParts(2024, 3, 5, 14, 30, 15)).toBe(1709649015)
        expect(DateTime.fromParts(1969, 12, 31, 23, 59, 59)).toBe(-1)
        expect(DateTime.fromParts(2023, 13, 1)).toBe(DateTime.fromParts(2024, 1, 1))
        let p = DateTime.toParts(1709649015)
        expect([p["year"], p["month"], p["day"], p["hour"], p["minute"], p["second"]]).toEqual([2024, 3, 5, 14, 30, 15])
        expect(p["weekday"]).toBe(2)
        expect(p["dayOfYear"]).toBe(65)
        let before = DateTime.toParts(-1)
        expect([before["year"], before["month"], before["day"], before["hour"], before["weekday"]]).toEqual([1969, 12, 31, 23, 3])
    })
    it("round-trips many dates", fn() {
        let ok = true
        for days in [-800000, -1, 0, 1, 59, 60, 11016, 19787, 2932896] {
            let ymd = DateTime.civilFromDays(days)
            if DateTime.daysFromCivil(ymd[0], ymd[1], ymd[2]) != days { ok = false }
        }
        expect(ok).toBeTruthy()
    })
})

describe("DateTime parse & format", fn() {
    it("parses ISO-style strings", fn() {
        expect(DateTime.parse("2024-03-05")).toBe(1709596800)
        expect(DateTime.parse("2024-03-05T14:30:15Z")).toBe(1709649015)
        expect(DateTime.parse("2024-03-05 14:30")).toBe(1709649000)
        expect(DateTime.parse("2024-03-05T14:30:15.250Z")).toBe(1709649015)
        expect(DateTime.parse("2024-03-05T19:30:15+05:00")).toBe(1709649015)
        expect(DateTime.parse("2024-03-05T09:30:15-05:00")).toBe(1709649015)
    })
    it("rejects invalid input", fn() {
        for bad in ["", "2024-02-30", "2024-13-01", "24-03-05", "2024-03-05T25:00", "2024-03-05X10:00", "2024-03-05T10:00Q", "abcd-ef-gh"] {
            expect(DateTime.parse(bad)).toBeNull()
        }
    })
    it("formats with tokens and literals", fn() {
        let t = 1709649015
        expect(DateTime.format(t, "YYYY-MM-DD HH:mm:ss")).toBe("2024-03-05 14:30:15")
        expect(DateTime.format(t, "dddd, MMMM D YYYY h:mm A")).toBe("Tuesday, March 5 2024 2:30 PM")
        expect(DateTime.format(t, "ddd DD MMM YY")).toBe("Tue 05 Mar 24")
        expect(DateTime.format(t, "[Due] M/D [at] hh:mm a")).toBe("Due 3/5 at 02:30 pm")
        expect(DateTime.format(DateTime.fromParts(2024, 1, 1, 0, 5), "h:mm A")).toBe("12:05 AM")
        expect(DateTime.toISO(t)).toBe("2024-03-05T14:30:15Z")
    })
})

describe("DateTime arithmetic", fn() {
    let t = DateTime.parse("2024-01-31T10:00:00Z")
    it("adds fixed units", fn() {
        expect(DateTime.toISO(DateTime.addDays(t, 1))).toBe("2024-02-01T10:00:00Z")
        expect(DateTime.toISO(DateTime.addHours(t, -11))).toBe("2024-01-30T23:00:00Z")
        expect(DateTime.toISO(DateTime.addWeeks(t, 2))).toBe("2024-02-14T10:00:00Z")
        expect(DateTime.toISO(DateTime.addMinutes(t, 90))).toBe("2024-01-31T11:30:00Z")
    })
    it("adds calendar months and years with clamping", fn() {
        expect(DateTime.toISO(DateTime.addMonths(t, 1))).toBe("2024-02-29T10:00:00Z")
        expect(DateTime.toISO(DateTime.addMonths(t, 13))).toBe("2025-02-28T10:00:00Z")
        expect(DateTime.toISO(DateTime.addMonths(t, -2))).toBe("2023-11-30T10:00:00Z")
        expect(DateTime.toISO(DateTime.addYears(DateTime.parse("2024-02-29"), 1))).toBe("2025-02-28T00:00:00Z")
    })
    it("computes differences", fn() {
        let a = DateTime.parse("2024-01-01T00:00:00Z")
        let b = DateTime.parse("2024-03-15T12:00:00Z")
        expect(DateTime.diff(a, b, "days")).toBe(74)
        expect(DateTime.diff(b, a, "days")).toBe(-74)
        expect(DateTime.diff(a, b, "hours")).toBe(1788)
        expect(DateTime.diff(a, b, "months")).toBe(2)
        expect(DateTime.diff(DateTime.parse("2024-01-31"), DateTime.parse("2024-02-29"), "months")).toBe(0)
        expect(DateTime.diff(DateTime.parse("2000-06-15"), DateTime.parse("2024-06-14"), "years")).toBe(23)
        expect(DateTime.age(DateTime.parse("2000-06-15"), DateTime.parse("2024-06-15"))).toBe(24)
        expect(fn() { DateTime.diff(a, b, "fortnights") }).toThrow()
    })
    it("finds period boundaries", fn() {
        let x = DateTime.parse("2024-03-06T15:45:00Z")
        expect(DateTime.toISO(DateTime.startOfDay(x))).toBe("2024-03-06T00:00:00Z")
        expect(DateTime.toISO(DateTime.endOfDay(x))).toBe("2024-03-06T23:59:59Z")
        expect(DateTime.toISO(DateTime.startOfMonth(x))).toBe("2024-03-01T00:00:00Z")
        expect(DateTime.toISO(DateTime.endOfMonth(x))).toBe("2024-03-31T23:59:59Z")
        expect(DateTime.toISO(DateTime.startOfWeek(x))).toBe("2024-03-04T00:00:00Z")
        expect(DateTime.toISO(DateTime.startOfWeek(x, 0))).toBe("2024-03-03T00:00:00Z")
        expect(DateTime.isWeekend(DateTime.parse("2024-03-09"))).toBeTruthy()
        expect(DateTime.isWeekend(x)).toBeFalsy()
        expect(DateTime.isSameDay(x, DateTime.parse("2024-03-06T01:00:00Z"))).toBeTruthy()
        expect(DateTime.toISO(DateTime.toLocal(x, 300))).toBe("2024-03-06T20:45:00Z")
    })
})

describe("DateTime human output", fn() {
    let base = 1709649015
    it("describes relative times", fn() {
        expect(DateTime.relative(base - 10, base)).toBe("just now")
        expect(DateTime.relative(base - 60, base)).toBe("1 minute ago")
        expect(DateTime.relative(base - 5 * 60, base)).toBe("5 minutes ago")
        expect(DateTime.relative(base + 3 * 3600, base)).toBe("in 3 hours")
        expect(DateTime.relative(base - 2 * 86400, base)).toBe("2 days ago")
        expect(DateTime.relative(base + 14 * 86400, base)).toBe("in 2 weeks")
        expect(DateTime.relative(base - 400 * 86400, base)).toBe("1 year ago")
    })
    it("formats durations", fn() {
        expect(DateTime.formatDuration(90061)).toBe("1d 1h 1m 1s")
        expect(DateTime.formatDuration(3600)).toBe("1h")
        expect(DateTime.formatDuration(0)).toBe("0s")
        expect(DateTime.formatClock(3725)).toBe("01:02:05")
    })
    it("reads the current time", fn() {
        expect(DateTime.now() > 1700000000).toBeTruthy()
    })
})

Test.report()
