# quantum-math — math toolkit for Quantum
#
#   QMath.mean([2, 4, 9])              # 5
#   QMath.primesUpTo(20)               # [2, 3, 5, 7, 11, 13, 17, 19]
#   QMath.toRoman(2024)                # "MMXXIV"
#   QMath.multiply([[1, 2]], [[3], [4]])   # [[11]]
#
# Exposes the global: QMath   (the native `Math` global is left untouched)

class __QMath {
    fn init() {
        self.DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"
    }

    # ── basics ───────────────────────────────────────────────────────────

    fn clamp(x, lo, hi) {
        if x < lo { return lo }
        if x > hi { return hi }
        return x
    }

    # Linear interpolation: t = 0 -> a, t = 1 -> b
    fn lerp(a, b, t) {
        return a + (b - a) * t
    }

    # Re-maps x from [inMin, inMax] to [outMin, outMax].
    fn mapRange(x, inMin, inMax, outMin, outMax) {
        return outMin + (x - inMin) * (outMax - outMin) / (inMax - inMin)
    }

    fn roundTo(x, decimals) {
        let f = pow(10, decimals)
        return round(x * f) / f
    }

    fn sign(x) {
        if x > 0 { return 1 }
        if x < 0 { return -1 }
        return 0
    }

    # Rounds toward zero (the native int() floors negatives).
    fn trunc(x) {
        return x < 0 ? -floor(-x) : floor(x)
    }

    # Always-positive modulo: mod(-1, 5) -> 4 (the % operator gives -1).
    fn mod(a, n) {
        return ((a % n) + n) % n
    }

    fn isInteger(x) {
        return type(x) == "number" and x == floor(x)
    }

    fn isEven(n) { return self.mod(n, 2) == 0 }
    fn isOdd(n) { return self.mod(n, 2) == 1 }

    fn approxEqual(a, b, epsilon) {
        if epsilon == null { epsilon = 0.000000001 }
        return abs(a - b) <= epsilon
    }

    fn degToRad(d) { return d * PI / 180 }
    fn radToDeg(r) { return r * 180 / PI }

    fn hypot(a, b) { return sqrt(a * a + b * b) }

    fn percentOf(part, whole) {
        if whole == 0 { return 0 }
        return part / whole * 100
    }

    fn percentChange(oldValue, newValue) {
        if oldValue == 0 { return 0 }
        return (newValue - oldValue) / abs(oldValue) * 100
    }

    # ── number theory ────────────────────────────────────────────────────

    fn factorial(n) {
        let result = 1
        for i in range(2, n + 1) { result *= i }
        return result
    }

    # nth Fibonacci number, fibonacci(0) = 0, fibonacci(1) = 1
    fn fibonacci(n) {
        let a = 0
        let b = 1
        for i in range(n) {
            let next = a + b
            a = b
            b = next
        }
        return a
    }

    # First n Fibonacci numbers.
    fn fibonacciSequence(n) {
        let out = []
        let a = 0
        let b = 1
        for i in range(n) {
            out.push(a)
            let next = a + b
            a = b
            b = next
        }
        return out
    }

    fn isPrime(n) {
        if not self.isInteger(n) or n < 2 { return false }
        if n < 4 { return true }
        if n % 2 == 0 { return false }
        let d = 3
        while d * d <= n {
            if n % d == 0 { return false }
            d += 2
        }
        return true
    }

    # Sieve of Eratosthenes.
    fn primesUpTo(n) {
        if n < 2 { return [] }
        let marks = []
        for i in range(n + 1) { marks.push(true) }
        let p = 2
        while p * p <= n {
            if marks[p] {
                let m = p * p
                while m <= n {
                    marks[m] = false
                    m += p
                }
            }
            p += 1
        }
        let out = []
        for i in range(2, n + 1) {
            if marks[i] { out.push(i) }
        }
        return out
    }

    # primeFactors(360) -> [2, 2, 2, 3, 3, 5]
    fn primeFactors(n) {
        let out = []
        let d = 2
        while d * d <= n {
            while n % d == 0 {
                out.push(d)
                n = n / d
            }
            d += 1
        }
        if n > 1 { out.push(n) }
        return out
    }

    fn divisors(n) {
        let small = []
        let large = []
        let d = 1
        while d * d <= n {
            if n % d == 0 {
                small.push(d)
                if d != n / d { large.push(n / d) }
            }
            d += 1
        }
        for i in range(len(large) - 1, -1, -1) { small.push(large[i]) }
        return small
    }

    fn gcd(a, b) {
        a = abs(a)
        b = abs(b)
        while b != 0 {
            let t = a % b
            a = b
            b = t
        }
        return a
    }

    fn lcm(a, b) {
        if a == 0 or b == 0 { return 0 }
        return abs(a * b) / self.gcd(a, b)
    }

    fn gcdOf(values) {
        let g = 0
        for v in values { g = self.gcd(g, v) }
        return g
    }

    fn lcmOf(values) {
        let l = 1
        for v in values { l = self.lcm(l, v) }
        return l
    }

    fn isPerfect(n) {
        if n < 2 { return false }
        let total = 0
        for d in self.divisors(n) {
            if d != n { total += d }
        }
        return total == n
    }

    # digits(9051) -> [9, 0, 5, 1]
    fn digits(n) {
        n = abs(self.trunc(n))
        if n == 0 { return [0] }
        let out = []
        while n > 0 {
            out.insert(0, n % 10)
            n = floor(n / 10)
        }
        return out
    }

    fn digitSum(n) {
        let total = 0
        for d in self.digits(n) { total += d }
        return total
    }

    # 153 = 1^3 + 5^3 + 3^3
    fn isArmstrong(n) {
        let ds = self.digits(n)
        let total = 0
        for d in ds { total += pow(d, len(ds)) }
        return total == n
    }

    # toBase(255, 16) -> "ff", toBase(5, 2) -> "101"
    fn toBase(n, base) {
        if n == 0 { return "0" }
        let negative = n < 0
        n = abs(self.trunc(n))
        let out = ""
        while n > 0 {
            out = self.DIGITS[n % base] + out
            n = floor(n / base)
        }
        return negative ? "-" + out : out
    }

    fn fromBase(s, base) {
        s = s.lower().trim()
        let negative = s.startsWith("-")
        if negative { s = s.slice(1) }
        let n = 0
        for ch in s.chars() {
            let v = self.DIGITS.indexOf(ch)
            if v == -1 or v >= base { raise "invalid digit '" + ch + "' for base " + str(base) }
            n = n * base + v
        }
        return negative ? -n : n
    }

    fn toRoman(n) {
        let values = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
        let symbols = ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
        let out = ""
        for i in range(len(values)) {
            while n >= values[i] {
                out += symbols[i]
                n -= values[i]
            }
        }
        return out
    }

    fn fromRoman(s) {
        let map = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
        s = s.upper()
        let total = 0
        for i in range(len(s)) {
            let v = map[s[i]]
            if i + 1 < len(s) and map[s[i + 1]] > v {
                total -= v
            } else {
                total += v
            }
        }
        return total
    }

    # ── combinatorics ────────────────────────────────────────────────────

    # n choose k, computed incrementally to avoid huge factorials.
    fn nCr(n, k) {
        if k < 0 or k > n { return 0 }
        if k > n - k { k = n - k }
        let result = 1
        for i in range(1, k + 1) {
            result = result * (n - k + i) / i
        }
        return round(result)
    }

    fn nPr(n, k) {
        if k < 0 or k > n { return 0 }
        let result = 1
        for i in range(n - k + 1, n + 1) { result *= i }
        return result
    }

    # All orderings of arr.
    fn permutations(arr) {
        if len(arr) <= 1 { return [arr.slice(0)] }
        let out = []
        for i in range(len(arr)) {
            let rest = arr.slice(0, i) + arr.slice(i + 1)
            for p in self.permutations(rest) {
                out.push([arr[i]] + p)
            }
        }
        return out
    }

    # All k-element selections of arr, in order.
    fn combinations(arr, k) {
        if k == 0 { return [[]] }
        if len(arr) < k { return [] }
        let out = []
        let head = arr[0]
        let tail = arr.slice(1)
        for c in self.combinations(tail, k - 1) { out.push([head] + c) }
        for c in self.combinations(tail, k) { out.push(c) }
        return out
    }

    fn powerSet(arr) {
        let out = [[]]
        for x in arr {
            let count = len(out)
            for i in range(count) { out.push(out[i] + [x]) }
        }
        return out
    }

    # ── statistics ───────────────────────────────────────────────────────

    fn sum(values) {
        let total = 0
        for v in values { total += v }
        return total
    }

    fn mean(values) {
        if len(values) == 0 { return 0 }
        return self.sum(values) / len(values)
    }

    fn median(values) {
        let n = len(values)
        if n == 0 { return 0 }
        let s = sorted(values)
        let mid = floor(n / 2)
        if n % 2 == 1 { return s[mid] }
        return (s[mid - 1] + s[mid]) / 2
    }

    # Most frequent value(s), in first-seen order.
    fn mode(values) {
        let counts = {}
        let order = []
        for v in values {
            let key = str(v)
            if not (key in counts) {
                counts[key] = 0
                order.push(v)
            }
            counts[key] += 1
        }
        let best = 0
        for v in order { best = max(best, counts[str(v)]) }
        return order.filter(fn(v) { return counts[str(v)] == best })
    }

    # Population variance; pass sample = true for the n - 1 (sample) estimate.
    fn variance(values, sample) {
        let n = len(values)
        if n == 0 or (sample and n < 2) { return 0 }
        let m = self.mean(values)
        let total = 0
        for v in values { total += (v - m) * (v - m) }
        return total / (sample ? n - 1 : n)
    }

    fn stdDev(values, sample) {
        return sqrt(self.variance(values, sample))
    }

    fn minOf(values) {
        let best = values[0]
        for v in values { if v < best { best = v } }
        return best
    }

    fn maxOf(values) {
        let best = values[0]
        for v in values { if v > best { best = v } }
        return best
    }

    # Linear-interpolated percentile, p in [0, 100].
    fn percentile(values, p) {
        let s = sorted(values)
        let n = len(s)
        if n == 0 { return 0 }
        let rank = p / 100 * (n - 1)
        let lo = floor(rank)
        let hi = ceil(rank)
        return s[lo] + (s[hi] - s[lo]) * (rank - lo)
    }

    fn weightedMean(values, weights) {
        let total = 0
        let wsum = 0
        for i in range(len(values)) {
            total += values[i] * weights[i]
            wsum += weights[i]
        }
        return wsum == 0 ? 0 : total / wsum
    }

    fn cumulativeSum(values) {
        let out = []
        let running = 0
        for v in values {
            running += v
            out.push(running)
        }
        return out
    }

    # Scales values into [0, 1].
    fn normalize(values) {
        let lo = self.minOf(values)
        let hi = self.maxOf(values)
        if hi == lo { return values.map(fn(v) { return 0 }) }
        return values.map(fn(v) { return (v - lo) / (hi - lo) })
    }

    # Pearson correlation coefficient in [-1, 1].
    fn correlation(xs, ys) {
        let mx = self.mean(xs)
        let my = self.mean(ys)
        let cov = 0
        let dx = 0
        let dy = 0
        for i in range(len(xs)) {
            cov += (xs[i] - mx) * (ys[i] - my)
            dx += (xs[i] - mx) * (xs[i] - mx)
            dy += (ys[i] - my) * (ys[i] - my)
        }
        if dx == 0 or dy == 0 { return 0 }
        return cov / sqrt(dx * dy)
    }

    # Least-squares line through points: returns {"slope", "intercept"}.
    fn linearRegression(xs, ys) {
        let mx = self.mean(xs)
        let my = self.mean(ys)
        let cov = 0
        let den = 0
        for i in range(len(xs)) {
            cov += (xs[i] - mx) * (ys[i] - my)
            den += (xs[i] - mx) * (xs[i] - mx)
        }
        let slope = den == 0 ? 0 : cov / den
        return {"slope": slope, "intercept": my - slope * mx}
    }

    # ── vectors & matrices ───────────────────────────────────────────────

    fn dot(a, b) {
        let total = 0
        for i in range(len(a)) { total += a[i] * b[i] }
        return total
    }

    fn magnitude(v) {
        return sqrt(self.dot(v, v))
    }

    fn distance(a, b) {
        let total = 0
        for i in range(len(a)) { total += (a[i] - b[i]) * (a[i] - b[i]) }
        return sqrt(total)
    }

    fn matrix(rows, cols, fill) {
        if fill == null { fill = 0 }
        let m = []
        for r in range(rows) {
            let row = []
            for c in range(cols) { row.push(fill) }
            m.push(row)
        }
        return m
    }

    fn identity(n) {
        let m = self.matrix(n, n, 0)
        for i in range(n) { m[i][i] = 1 }
        return m
    }

    fn transpose(m) {
        let out = []
        for c in range(len(m[0])) {
            let row = []
            for r in range(len(m)) { row.push(m[r][c]) }
            out.push(row)
        }
        return out
    }

    fn addMatrices(a, b) {
        let out = []
        for r in range(len(a)) {
            let row = []
            for c in range(len(a[0])) { row.push(a[r][c] + b[r][c]) }
            out.push(row)
        }
        return out
    }

    fn scaleMatrix(m, k) {
        return m.map(fn(row) { return row.map(fn(x) { return x * k }) })
    }

    fn multiply(a, b) {
        if len(a[0]) != len(b) { raise "matrix size mismatch: " + str(len(a[0])) + " columns vs " + str(len(b)) + " rows" }
        let out = self.matrix(len(a), len(b[0]), 0)
        for i in range(len(a)) {
            for j in range(len(b[0])) {
                let total = 0
                for k in range(len(b)) { total += a[i][k] * b[k][j] }
                out[i][j] = total
            }
        }
        return out
    }

    fn copyMatrix(m) {
        return m.map(fn(row) { return row.slice(0) })
    }

    # Determinant by Gaussian elimination with partial pivoting.
    fn determinant(m) {
        let a = self.copyMatrix(m)
        let n = len(a)
        let det = 1
        for col in range(n) {
            let pivot = col
            for r in range(col + 1, n) {
                if abs(a[r][col]) > abs(a[pivot][col]) { pivot = r }
            }
            if a[pivot][col] == 0 { return 0 }
            if pivot != col {
                let tmp = a[pivot]
                a[pivot] = a[col]
                a[col] = tmp
                det = -det
            }
            det *= a[col][col]
            for r in range(col + 1, n) {
                let f = a[r][col] / a[col][col]
                for c in range(col, n) { a[r][c] -= f * a[col][c] }
            }
        }
        return det
    }

    # Inverse by Gauss-Jordan elimination; raises for singular matrices.
    fn inverse(m) {
        let n = len(m)
        let a = self.copyMatrix(m)
        let inv = self.identity(n)
        for col in range(n) {
            let pivot = col
            for r in range(col + 1, n) {
                if abs(a[r][col]) > abs(a[pivot][col]) { pivot = r }
            }
            if abs(a[pivot][col]) < 0.000000000001 { raise "matrix is singular" }
            let t1 = a[pivot]
            a[pivot] = a[col]
            a[col] = t1
            let t2 = inv[pivot]
            inv[pivot] = inv[col]
            inv[col] = t2
            let p = a[col][col]
            for c in range(n) {
                a[col][c] /= p
                inv[col][c] /= p
            }
            for r in range(n) {
                if r == col { continue }
                let f = a[r][col]
                for c in range(n) {
                    a[r][c] -= f * a[col][c]
                    inv[r][c] -= f * inv[col][c]
                }
            }
        }
        return inv
    }

    # ── geometry & finance ───────────────────────────────────────────────

    fn circleArea(r) { return PI * r * r }
    fn circleCircumference(r) { return 2 * PI * r }

    # Heron's formula from the three side lengths.
    fn triangleArea(a, b, c) {
        let s = (a + b + c) / 2
        return sqrt(s * (s - a) * (s - b) * (s - c))
    }

    # Final amount after compounding `timesPerYear` times for `years`.
    fn compoundInterest(principal, annualRate, years, timesPerYear) {
        if timesPerYear == null { timesPerYear = 12 }
        return principal * pow(1 + annualRate / timesPerYear, timesPerYear * years)
    }

    # Fixed monthly payment for a loan (annualRate as a fraction, e.g. 0.05).
    fn loanPayment(principal, annualRate, months) {
        if annualRate == 0 { return principal / months }
        let r = annualRate / 12
        return principal * r / (1 - pow(1 + r, -months))
    }
}

QMath = __QMath()
